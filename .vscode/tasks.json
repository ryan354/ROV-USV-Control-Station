{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "-B", "build",
                "-G", "Visual Studio 17 2022",
                "-DCMAKE_PREFIX_PATH=C:/Qt/6.8.3/msvc2022_64",
                "-DENABLE_SDL2=ON",
                "-Wno-dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "--build", "build",
                "--config", "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "--build", "build",
                "--config", "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Deploy All DLLs",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}\\deploy.bat"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build & Deploy Release",
            "dependsOn": ["CMake: Build Release", "Deploy All DLLs"],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "--build", "build",
                "--config", "Release",
                "--clean-first"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run RovoControl",
            "type": "shell",
            "command": "${workspaceFolder}/build/Release/RovoControl.exe",
            "options": {
                "cwd": "${workspaceFolder}/build/Release"
            },
            "dependsOn": "Build & Deploy Release",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
